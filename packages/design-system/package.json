{
  "name": "@is3a/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "IS3A theme tokens and shared React components, with a Storybook component workshop.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./cn": "./src/cn.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react-day-picker": "^10.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
