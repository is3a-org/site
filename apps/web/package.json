{
  "name": "@is3a/web",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "vp run build && wrangler deploy",
    "preview": "vp run build && vp preview",
    "types:generate": "wrangler types --env-interface CloudflareEnv",
    "db:fragno:generate": "fragno-cli db generate app/fragno/simple-auth-server.ts app/fragno/otp-server.ts app/fragno/stripe-server.ts app/fragno/forms-server.ts --format drizzle -o app/db/postgres/fragno-schema.ts",
    "db:postgres:push": "drizzle-kit push --config postgres.drizzle.config.ts",
    "db:postgres:generate": "drizzle-kit generate --config postgres.drizzle.config.ts",
    "db:postgres:migrate": "drizzle-kit migrate --config postgres.drizzle.config.ts",
    "stripe": "node --env-file-if-exists=.env ../../tooling/stripe.mjs",
    "stripe:webhook": "node --env-file=.env ../../tooling/stripe.mjs listen --all-snapshot"
  },
  "dependencies": {
    "@fragno-dev/auth": "0.0.0-canary-40098233613-1-20261024132858",
    "@fragno-dev/db": "0.0.0-canary-40098233613-1-20261024132858",
    "@fragno-dev/forms": "0.0.0-canary-40098233613-1-20261024132858",
    "@fragno-dev/jsonforms-shadcn-renderers": "0.0.0-canary-40098233613-1-20261024132858",
    "@fragno-dev/stripe": "0.0.0-canary-40098233613-1-20261024132858",
    "@is3a/design-system": "workspace:*",
    "@is3a/one-time-password-fragment": "workspace:*",
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/react": "^3.8.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/pg": "^8.23.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@fragno-dev/cli": "0.0.0-canary-40098233613-1-20261024132858",
    "@react-router/dev": "^8.5.0",
    "@stripe/cli": "1.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  }
}
