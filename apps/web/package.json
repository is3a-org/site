{
  "name": "@is3a/web",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "vp run build && wrangler deploy",
    "preview": "vp run build && vp preview",
    "types:generate": "wrangler types --env-interface CloudflareEnv",
    "db:fragno:generate": "fragno-cli db generate app/fragno/simple-auth-server.ts app/fragno/otp-server.ts app/fragno/stripe-server.ts app/fragno/forms-server.ts --format drizzle -o app/db/postgres/fragno-schema.ts",
    "db:postgres:push": "drizzle-kit push --config postgres.drizzle.config.ts",
    "db:postgres:generate": "drizzle-kit generate --config postgres.drizzle.config.ts",
    "db:postgres:migrate": "drizzle-kit migrate --config postgres.drizzle.config.ts",
    "stripe:webhook": "stripe listen --forward-to localhost:5173/api/stripe/webhook"
  },
  "dependencies": {
    "@fragno-dev/auth": "0.0.14",
    "@fragno-dev/db": "0.3.0",
    "@fragno-dev/forms": "0.1.0",
    "@fragno-dev/jsonforms-shadcn-renderers": "0.0.2",
    "@fragno-dev/stripe": "2.0.0",
    "@is3a/design-system": "workspace:*",
    "@is3a/one-time-password-fragment": "workspace:*",
    "@jsonforms/core": "^3.7.0",
    "@jsonforms/react": "^3.7.0",
    "@marsidev/react-turnstile": "^1.4.0",
    "@paralleldrive/cuid2": "^3.1.0",
    "@types/pg": "^8.15.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.548.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@fragno-dev/cli": "0.2.1",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  }
}
