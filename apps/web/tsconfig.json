{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.cloudflare.json"
    }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"],
    "paths": {
      "@/components/ui/*": ["../../packages/design-system/src/components/*"],
      "@/*": ["./app/*"],
      "~/*": ["./app/*"]
    },
    "allowImportingTsExtensions": true
  }
}
